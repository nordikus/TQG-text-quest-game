class_name QuestData
extends RefCounted

static func get_quest(quest_id: String) -> Dictionary:
	match quest_id:
		"burning_grove":
			return {
				"id": "burning_grove",
				"title": "Горящая роща",
				"start_node": "start",
				"nodes": {
					"start": {
						"text": "Перед взором появляется видение пожара в лесу, стоит ли сохранить лес или дать ему сгореть?",
						"choices": [
							{
								"text": "Потушить пожар",
								"next_node": "extinguish"
							},
							{
								"text": "Пройти мимо",
								"next_node": "pass_by"
							}
						]
					},
					"extinguish": {
						"text": "Ты концентрируешься и уничтожаешь пламя быстрыми взмахами. Внезапно из остывшего пепла пробивается изумрудный росток вырастающий в огромное дерево.",
						"ending_id": "extinguish_fire",
						"choices": [
							{
								"text": "Запечатлеть историю в книге",
								"next_node": ""
							}
						]
					},
					"pass_by": {
						"text": "Ты отступаешь позволяя огню бушевать, перед тобой выгорает тропа до замка.\nЗа дымом слышен лязг цепей. Внешняя решётка крепости поднимается, и по выжженной дороге можно пройти во двор.",
						"ending_id": "pass_by",
						"choices": [
							{
								"text": "Запечатлеть историю в книге",
								"next_node": ""
							}
						]
					}
				}
			}
		"deal_at_the_throne":
			return {
				"id": "deal_at_the_throne",
				"title": "Сделка у Трона",
				"start_node": "start",
				"nodes": {
					"start": {
						"text": "Ты видишь видение: ты сидишь на троне, а перед тобой странник в мантии, который молвит\n-Ваше величество, я могу дать вам возможность изменить свою судьбу.\n\nЧто ты решишь?",
						"choices": [
							{
								"text": "Согласиться на сделку",
								"next_node": "accept"
							},
							{
								"text": "Отказаться от сделки",
								"next_node": "reject"
							}
						]
					},
					"accept": {
						"text": "Ты принимаешь предложение странника. Он протягивает тебе перо и растворяется в воздухе.\n\nНа каменном постаменте вместо книги остается лишь Великое перо. Кто знает что будет если им изменить уже написанную историю.",
						"ending_id": "accept_deal",
						"choices": [
							{
								"text": "Принять власть над судьбой",
								"next_node": ""
							}
						]
					},
					"reject": {
						"text": "Ты отвергаешь соблазн изменить прошлое, признавая, что каждый сделанный шаг — необходим для становления собой.\n\nТяжёлый переплёт книги с глухим стуком захлопывается.",
						"ending_id": "reject_deal",
						"choices": [
							{
								"text": "Запечатлеть свершившееся",
								"next_node": ""
							}
						]
					}
				}
			}
	return {}
