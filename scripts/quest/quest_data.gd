class_name QuestData
extends RefCounted

static func get_quest(quest_id: String) -> Dictionary:
	match quest_id:
		"burning_grove":
			return {
				"id": "burning_grove",
				"title": "Горящая роща",
				"start_node": "start",
				"nodes": {
					"start": {
						"text": "Перед вашим взором вздымается пламя. Древняя роща охвачена неестественным багровым огнем. В ушах стоит треск горящей древесины и безмолвный стон живого леса.\n\nПеред вами лежит решение, способное изменить саму ткань реальности.",
						"choices": [
							{
								"text": "Потушить пожар (Собрать природные силы)",
								"next_node": "extinguish"
							},
							{
								"text": "Пройти мимо (Позволить огню свершить свое)",
								"next_node": "pass_by"
							}
						]
					},
					"extinguish": {
						"text": "Вы концентрируетесь и сбиваете яростное пламя. Земля жадно впитывает тепло.\n\nВнезапно из остывшего пепла пробивается изумрудный росток. Прямо на ваших глазах ввысь устремляется исполинское древнее древо! Его узловатые могучие ветви переплетаются и образуют мост-лестницу, ведущую прямо к верхним ярусам Башни Мага.",
						"ending_id": "extinguish_fire",
						"choices": [
							{
								"text": "Запечатлеть историю в книге",
								"next_node": ""
							}
						]
					},
					"pass_by": {
						"text": "Вы отступаете назад, позволяя огню бушевать. Багровое пламя пожирает непроходимый терновник и вековые преграды.\n\nКогда дым слегка рассеивается, перед вами открывается широкая выжженная дорога, ведущая прямо к массивным крепостным стенам и главным воротам замка.",
						"ending_id": "pass_by",
						"choices": [
							{
								"text": "Запечатлеть историю в книге",
								"next_node": ""
							}
						]
					}
				}
			}
	return {}
